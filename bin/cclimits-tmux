#!/bin/bash
# Non-blocking tmux status-line wrapper for cclimits.
#
# tmux runs #(...) synchronously, so a slow command freezes the whole status
# line. This prints the cached result instantly (zero latency) and refreshes
# it in the background only when older than TTL seconds.
#
# Usage in ~/.tmux.conf:
#   set -g status-right-length 150
#   set -g status-right '#[fg=cyan]#(/path/to/cclimits-tmux)'
#
# A failed lookup (e.g. HTTP 429 from a shared rate limit) must never clobber
# a good cached reading, and must not make every pane retry immediately.  So
# the refresh interval is keyed on a "lease" file stamped when a lookup
# *starts*, not on the cache mtime: one pane claims the lease, the rest stay
# quiet for TTL seconds whether or not that lookup succeeded.
#
# Environment overrides:
#   CCLIMITS_TMUX_TTL    refresh interval in seconds (default: 180)
#   CCLIMITS_TMUX_ARGS   cclimits arguments (default: --claude --codex --grok --oneline both --compact --resets)
#   CCLIMITS_BIN         path to the cclimits executable
#   GROK_BIN             path to the official Grok executable (default: grok)

set -u

TTL=${CCLIMITS_TMUX_TTL:-180}
ARGS=${CCLIMITS_TMUX_ARGS:---claude --codex --grok --oneline both --compact --resets}
# Key the cache on the argument list so different views (e.g. --claude only
# vs --claude --codex) never serve each other's output.
ARGS_KEY=$(printf '%s' "$ARGS" | cksum | cut -d' ' -f1)
CACHE="${TMPDIR:-/tmp}/cclimits-tmux.$(id -u).$ARGS_KEY.cache"
LEASE="$CACHE.lease"
# Unlike the argument-keyed data cache, this display cache survives view/flag
# changes. tmux therefore always has a last-known-good string while the first
# lookup for a new argument set runs in the background.
DISPLAY_CACHE="${TMPDIR:-/tmp}/cclimits-tmux.$(id -u).display.cache"
DISPLAY_TMP="$DISPLAY_CACHE.$BASHPID.tmp"
GROK_CMD=${GROK_BIN:-grok}

# Resolve cclimits: explicit override, then the repo checkout this script
# lives in, then PATH.
if [ -n "${CCLIMITS_BIN:-}" ]; then
  CMD=("$CCLIMITS_BIN")
else
  self_dir=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
  if [ -f "$self_dir/../lib/cclimits.py" ]; then
    CMD=(python3 "$self_dir/../lib/cclimits.py")
  else
    CMD=(cclimits)
  fi
fi

# Serve a value immediately. The stable display cache prevents a blank status
# line when arguments change or an argument-keyed cache has not been built yet.
if [ -s "$CACHE" ]; then
  cat -- "$CACHE"
elif [ -s "$DISPLAY_CACHE" ]; then
  cat -- "$DISPLAY_CACHE"
fi

# Refresh only if no lookup has been attempted within the last TTL seconds.
if [ ! -f "$LEASE" ] || [ $(( $(date +%s) - $(stat -c %Y -- "$LEASE") )) -ge "$TTL" ]; then
  (
    flock -n 9 || exit 0
    # Claim the lease before querying so panes starting up in parallel back
    # off immediately instead of all firing at the rate-limited endpoint.
    : >"$LEASE"

    # shellcheck disable=SC2086  # ARGS is an intentional word-split option list
    if ! "${CMD[@]}" $ARGS >"$CACHE.tmp" 2>/dev/null; then
      rm -f -- "$CACHE.tmp"
      exit 0
    fi

    # An expired Grok session can be refreshed safely by the official CLI's
    # model-list command. It exercises AuthManager (including xAI's rotating-RT
    # lock/write protocol) but does not send a model prompt or consume credits.
    if grep -qE 'Grok:(expired|⏰)' -- "$CACHE.tmp" && command -v "$GROK_CMD" >/dev/null 2>&1; then
      if "$GROK_CMD" models >/dev/null 2>&1; then
        # shellcheck disable=SC2086
        "${CMD[@]}" $ARGS >"$CACHE.tmp" 2>/dev/null || true
      fi
    fi

    # cclimits exits 0 even when a provider lookup fails, marking the entry
    # with a failure icon instead.  Treat such output as a failure so a
    # transient outage never overwrites a good reading.
    if [ ! -s "$CACHE.tmp" ] || grep -qE '❌|🔑|⏰|ERR|:(expired|no key)(_|$)' -- "$CACHE.tmp"; then
      # No prior reading to protect: show the failure rather than nothing.
      if [ ! -s "$CACHE" ] && [ -s "$CACHE.tmp" ]; then
        mv -- "$CACHE.tmp" "$CACHE"
        cp -- "$CACHE" "$DISPLAY_TMP" && mv -- "$DISPLAY_TMP" "$DISPLAY_CACHE"
      fi
      rm -f -- "$CACHE.tmp"
      exit 0
    fi

    mv -- "$CACHE.tmp" "$CACHE"
    cp -- "$CACHE" "$DISPLAY_TMP" && mv -- "$DISPLAY_TMP" "$DISPLAY_CACHE"
  ) 9>"$CACHE.lock" >/dev/null 2>&1 &
fi

exit 0
