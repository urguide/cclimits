#!/bin/bash
# Non-blocking tmux status-line wrapper for cclimits.
#
# tmux runs #(...) synchronously, so a slow command freezes the whole status
# line. This prints the cached result instantly (zero latency) and refreshes
# it in the background only when older than TTL seconds.
#
# Usage in ~/.tmux.conf:
#   set -g status-right-length 150
#   set -g status-right '#[fg=cyan]#(/path/to/cclimits-tmux)'
#
# A failed lookup (e.g. HTTP 429 from a shared rate limit) must never clobber
# a good cached reading, and must not make every pane retry immediately.  So
# the refresh interval is keyed on a "lease" file stamped when a lookup
# *starts*, not on the cache mtime: one pane claims the lease, the rest stay
# quiet for TTL seconds whether or not that lookup succeeded.
#
# Environment overrides:
#   CCLIMITS_TMUX_TTL    refresh interval in seconds (default: 180)
#   CCLIMITS_TMUX_WATCH_INTERVAL  status emission interval (default: 2)
#   CCLIMITS_TMUX_PLACEHOLDER  cold-cache placeholder line (default: cclimits...)
#   CCLIMITS_TMUX_ERROR  line shown when the wrapper itself fails (default: cclimits!)
#   CCLIMITS_TMUX_SEP    display separator replacing --compact's `_` (default: none)
#   CCLIMITS_TMUX_ARGS   cclimits arguments (default: --claude --codex --grok --oneline both --compact --resets)
#   CCLIMITS_BIN         path to the cclimits executable
#   GROK_BIN             path to the official Grok executable (default: grok)

set -u

# tmux's #() formatter is most stable with a long-running command: it retains
# the last complete output line until the process emits a replacement. A
# short-lived command is restarted on status redraws and some tmux versions
# temporarily render an empty result between job start and exit, causing a
# visible on/off flicker even when the command itself takes only milliseconds.
#
# On a cold cache there is nothing to serve yet.  Emitting nothing at all is
# worse than a placeholder: tmux renders its own `<'...' not ready>` marker for
# a job that has produced no line within a second.  So always emit a complete
# line, falling back to a short placeholder until the first lookup lands.
# Empty output and a *failed* self-invocation are different faults and must not
# share one indicator. An empty line means "cache still cold" — expected, and it
# resolves itself. A non-zero exit means this script could not run at all: it was
# truncated or overwritten mid-download (a `curl -o` without `-f` stores HTTP
# error bodies and still exits 0), its interpreter is missing, or the mode bits
# were lost. That state never resolves itself and needs a visibly different
# marker, otherwise the status line sits on the reassuring `cclimits...` forever
# while the real cause is undiagnosable from the status line alone.
if [ "${1:-}" = "--watch" ]; then
  WATCH_INTERVAL=${CCLIMITS_TMUX_WATCH_INTERVAL:-2}
  # Not ':-' — an explicitly empty placeholder is a valid choice (accepting
  # tmux's own marker) and must not silently revert to the default.
  PLACEHOLDER=${CCLIMITS_TMUX_PLACEHOLDER-cclimits...}
  ERROR_LINE=${CCLIMITS_TMUX_ERROR-cclimits!}
  while :; do
    # Capturing stderr keeps a broken self-invocation from spamming the tmux
    # server log on every tick.
    if watch_out=$("$0" 2>/dev/null); then
      if [ -n "$watch_out" ]; then
        printf '%s\n' "$watch_out"
      else
        printf '%s\n' "$PLACEHOLDER"
      fi
    else
      printf '%s\n' "$ERROR_LINE"
    fi
    sleep "$WATCH_INTERVAL"
  done
fi

TTL=${CCLIMITS_TMUX_TTL:-180}
ARGS=${CCLIMITS_TMUX_ARGS:---claude --codex --grok --oneline both --compact --resets}
# Key the cache on the argument list so different views (e.g. --claude only
# vs --claude --codex) never serve each other's output.
ARGS_KEY=$(printf '%s' "$ARGS" | cksum | cut -d' ' -f1)
CACHE="${TMPDIR:-/tmp}/cclimits-tmux.$(id -u).$ARGS_KEY.cache"
LEASE="$CACHE.lease"
# Unlike the argument-keyed data cache, this display cache survives view/flag
# changes. tmux therefore always has a last-known-good string while the first
# lookup for a new argument set runs in the background.
DISPLAY_CACHE="${TMPDIR:-/tmp}/cclimits-tmux.$(id -u).display.cache"
DISPLAY_TMP="$DISPLAY_CACHE.$BASHPID.tmp"
GROK_CMD=${GROK_BIN:-grok}
# cod-twitter, the --icons label for Grok.  Kept as an escape rather than a
# literal so this file stays legible in an editor without a patched font.
GROK_ICON=$'\ueb72'

# Resolve cclimits: explicit override, then the repo checkout this script
# lives in, then PATH.
if [ -n "${CCLIMITS_BIN:-}" ]; then
  CMD=("$CCLIMITS_BIN")
else
  self_dir=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
  if [ -f "$self_dir/../lib/cclimits.py" ]; then
    CMD=(python3 "$self_dir/../lib/cclimits.py")
  else
    CMD=(cclimits)
  fi
fi

# The `_` between providers comes from --compact, which drops the wider ` | `
# to save columns.  CCLIMITS_TMUX_SEP swaps that one character for an arbitrary
# display string — typically a tmux style sequence drawing a coloured bar to
# match the pane/window dividers, e.g.
#   CCLIMITS_TMUX_SEP='#[fg=#ff8800]┃#[fg=cyan]'
# The trailing style restores the status-right colour, since #[...] persists to
# the end of the line.
#
# Substitution happens when *serving*, never when caching, for two reasons:
# the transient-failure grep below matches the raw `:expired(_|$)` form and
# would be defeated by an arbitrary separator, and a changed separator takes
# effect on the next redraw instead of waiting out the refresh TTL.
#
# Consuming one `_`-delimited field at a time rather than `${line//_/$SEP}` or
# sed, because both interpret the replacement text.  Bash 5.2+ expands an
# unquoted `&` in a substitution replacement to the matched text, so a separator
# like `#[fg=red]&` would emit a stray `_`; sed additionally reinterprets `&`,
# `\` and the `|` many users pick as their bar character.  Passing the separator
# as a printf *argument* keeps it byte-for-byte literal.
serve() {
  local file=$1 line rest
  if [ -z "${CCLIMITS_TMUX_SEP:-}" ]; then
    cat -- "$file"
    return
  fi
  # `|| [ -n "$line" ]` also emits a final line with no trailing newline.
  while IFS= read -r line || [ -n "$line" ]; do
    rest=$line
    # Stripping through the first `_` shortens the string, so this differs from
    # $rest exactly while one remains.
    while [ "${rest#*_}" != "$rest" ]; do
      printf '%s%s' "${rest%%_*}" "$CCLIMITS_TMUX_SEP"
      rest=${rest#*_}
    done
    printf '%s\n' "$rest"
  done <"$file"
}

# Serve a value immediately. The stable display cache prevents a blank status
# line when arguments change or an argument-keyed cache has not been built yet.
if [ -s "$CACHE" ]; then
  serve "$CACHE"
elif [ -s "$DISPLAY_CACHE" ]; then
  serve "$DISPLAY_CACHE"
fi

# Refresh only if no lookup has been attempted within the last TTL seconds.
if [ ! -f "$LEASE" ] || [ $(( $(date +%s) - $(stat -c %Y -- "$LEASE") )) -ge "$TTL" ]; then
  (
    flock -n 9 || exit 0
    # Claim the lease before querying so panes starting up in parallel back
    # off immediately instead of all firing at the rate-limited endpoint.
    : >"$LEASE"

    # shellcheck disable=SC2086  # ARGS is an intentional word-split option list
    if ! "${CMD[@]}" $ARGS >"$CACHE.tmp" 2>/dev/null; then
      rm -f -- "$CACHE.tmp"
      exit 0
    fi

    # An expired Grok session can be refreshed safely by the official CLI's
    # model-list command. It exercises AuthManager (including xAI's rotating-RT
    # lock/write protocol) but does not send a model prompt or consume credits.
    #
    # Both spellings of the label must match: --icons replaces `Grok` with the
    # cod-twitter glyph (U+EB72).  Matching only the word would silently
    # disable auto-refresh for icon users — the status line would sit on
    # `expired` until the next manual `grok` run, with nothing to indicate
    # that the recovery path had stopped firing.
    if grep -qE "(Grok|$GROK_ICON):(expired|⏰)" -- "$CACHE.tmp" && command -v "$GROK_CMD" >/dev/null 2>&1; then
      if "$GROK_CMD" models >/dev/null 2>&1; then
        # shellcheck disable=SC2086
        "${CMD[@]}" $ARGS >"$CACHE.tmp" 2>/dev/null || true
      fi
    fi

    # cclimits exits 0 even when a provider lookup fails, marking the entry
    # with a failure icon instead.  Treat *transient* failures as a failure so
    # an outage never overwrites a good reading.
    #
    # Only transient states qualify: an API error (❌/ERR) or an expired token
    # (⏰/expired) can succeed on the next attempt, so the last good reading is
    # worth protecting.  A missing credential (🔑/`no key`) is a stable
    # configuration state — retrying cannot change it, and treating it as a
    # failure would reject every refresh forever, freezing the percentages of
    # the providers that *are* working (e.g. `Grok:no key` in an otherwise
    # healthy `Claude:…_Codex:…_Grok:no key` line).
    if [ ! -s "$CACHE.tmp" ] || grep -qE '❌|⏰|ERR|:expired(_|$)' -- "$CACHE.tmp"; then
      # No prior reading to protect: show the failure rather than nothing.
      if [ ! -s "$CACHE" ] && [ -s "$CACHE.tmp" ]; then
        mv -- "$CACHE.tmp" "$CACHE"
        cp -- "$CACHE" "$DISPLAY_TMP" && mv -- "$DISPLAY_TMP" "$DISPLAY_CACHE"
      fi
      rm -f -- "$CACHE.tmp"
      exit 0
    fi

    mv -- "$CACHE.tmp" "$CACHE"
    cp -- "$CACHE" "$DISPLAY_TMP" && mv -- "$DISPLAY_TMP" "$DISPLAY_CACHE"
  ) 9>"$CACHE.lock" >/dev/null 2>&1 &
fi

exit 0
